{
  "name": "murevet-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-murevet \"jest --runInBand test/rules\"",
    "test:functions": "npm run build && firebase emulators:exec --only auth,firestore,functions --project demo-murevet \"jest --runInBand test/functions\"",
    "test": "npm run build && firebase emulators:exec --project demo-murevet \"jest --runInBand\""
  },
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^6.6.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/jest": "^29.5.14",
    "firebase": "^11.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  }
}
